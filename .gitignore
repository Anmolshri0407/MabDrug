# ==========================================
# Mab Drug - Root .gitignore
# ==========================================

# Environment variables & secrets (CRITICAL: Never commit credentials!)
.env
.env.*
!.env.example
backend/.env
Frontend-pharma/.env
Frontend-pharma/.env.local

# Python & Virtual Environments
venv/
env/
ENV/
.venv/
backend/venv/
*.py[cod]
*$py.class
__pycache__/
backend/**/__pycache__/
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Django
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
media/

# Node & Frontend
node_modules/
Frontend-pharma/node_modules/
Frontend-pharma/dist/
Frontend-pharma/dist-ssr/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# IDE & Editor files
.vscode/
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
